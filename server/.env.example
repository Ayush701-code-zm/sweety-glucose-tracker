# Port the API listens on
PORT=4000

# PostgreSQL connection string for the app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety

# Separate database used by the test suite (it is wiped between tests)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_test

# Secret used to sign login tokens. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Timezone used to decide what "today" is when rejecting future dates
APP_TIMEZONE=Asia/Kolkata

# Origin of the React app, used for CORS
CLIENT_ORIGIN=http://localhost:5173
